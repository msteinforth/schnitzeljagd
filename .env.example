# Kopieren nach .env und anpassen. Werte passen zu docker-compose.yml.

# local | staging | production
APP_ENV=local

DATABASE_URL=postgres://schnitzeljagd:schnitzeljagd@localhost:5432/schnitzeljagd

# S3-kompatibler Objektspeicher (lokal: MinIO). In Staging/Produktion ein Bucket in einer EU-Region.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=schnitzeljagd-media
S3_ACCESS_KEY_ID=schnitzeljagd
S3_SECRET_ACCESS_KEY=schnitzeljagd-secret
S3_FORCE_PATH_STYLE=true

# Google Maps (Maps JavaScript API, Places API, Directions API).
# Schlüssel in der Google Cloud Console auf die eigenen Domains beschränken.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
